# This file documents a real production configuration. Do not commit populated secrets.
# The included Terraform deployment uses AWS Secrets Manager instead of this file.

PROXY_APP_ENV=production
PROXY_LOG_LEVEL=INFO
PROXY_SERVICE_VERSION=0.1.0
PROXY_HOST=0.0.0.0
PROXY_PORT=8000
PROXY_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/permission_enforcer
PROXY_REDIS_URL=redis://REDIS_HOST:6379/0
PROXY_CRM_BASE_URL=http://127.0.0.1:8001
PROXY_CRM_INTERNAL_API_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PROXY_UPSTREAM_TIMEOUT_SECONDS=5
PROXY_OIDC_ISSUER=https://YOUR_IDENTITY_PROVIDER/
PROXY_OIDC_AUDIENCE=tool-permission-enforcer
PROXY_OIDC_JWKS_URL=https://YOUR_IDENTITY_PROVIDER/.well-known/jwks.json
PROXY_OIDC_ALGORITHM=RS256
PROXY_DEV_AUTH_ENABLED=false
PROXY_SESSION_TOKEN_ISSUER=tool-permission-enforcer
PROXY_SESSION_TOKEN_AUDIENCE=agent-session
PROXY_SESSION_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PROXY_SESSION_TOKEN_TTL_SECONDS=1800

CRM_APP_ENV=production
CRM_LOG_LEVEL=INFO
CRM_SERVICE_VERSION=0.1.0
CRM_HOST=0.0.0.0
CRM_PORT=8001
CRM_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/permission_enforcer
CRM_INTERNAL_API_KEY=REPLACE_WITH_THE_SAME_CRM_KEY_AS_THE_PROXY

