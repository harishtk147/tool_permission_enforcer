# Permission proxy
PROXY_APP_ENV=local
PROXY_LOG_LEVEL=INFO
PROXY_SERVICE_VERSION=0.1.0
PROXY_HOST=0.0.0.0
PROXY_PORT=8000
PROXY_DATABASE_URL=postgresql+psycopg://permission:permission@postgres:5432/permission_enforcer
PROXY_REDIS_URL=redis://redis:6379/0
PROXY_CRM_BASE_URL=http://sample-crm:8001
PROXY_CRM_INTERNAL_API_KEY=local-development-only-change-me
PROXY_UPSTREAM_TIMEOUT_SECONDS=5
PROXY_OIDC_ISSUER=http://localhost:8081/dev-issuer
PROXY_OIDC_AUDIENCE=tool-permission-enforcer
# PROXY_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
PROXY_OIDC_ALGORITHM=RS256
PROXY_DEV_AUTH_ENABLED=true
PROXY_DEV_JWT_SECRET=local-development-access-token-secret-change-me
PROXY_SESSION_TOKEN_ISSUER=tool-permission-enforcer
PROXY_SESSION_TOKEN_AUDIENCE=agent-session
PROXY_SESSION_SIGNING_SECRET=local-development-session-secret-change-me
PROXY_SESSION_TOKEN_TTL_SECONDS=1800

# Sample CRM
CRM_APP_ENV=local
CRM_LOG_LEVEL=INFO
CRM_SERVICE_VERSION=0.1.0
CRM_HOST=0.0.0.0
CRM_PORT=8001
CRM_DATABASE_URL=postgresql+psycopg://permission:permission@postgres:5432/permission_enforcer
CRM_INTERNAL_API_KEY=local-development-only-change-me

# Reference agent (enabled with the Docker Compose "agent" profile)
AGENT_APP_ENV=local
AGENT_LOG_LEVEL=INFO
AGENT_SERVICE_VERSION=0.1.0
AGENT_HOST=0.0.0.0
AGENT_PORT=8002
AGENT_PROXY_BASE_URL=http://permission-proxy:8000
AGENT_LLM_PROVIDER=disabled
AGENT_LLM_API_KEY=
